	{
		"id": "-1000007221",
		"key": "story_E0_1",
		"en|ch|tc|kr": "「おまえさん、この老いた膝ではもう高い段々畑に登れんのじゃ。しばらく庭を見てくれんか？」"
	},
	{
		"id": "-1000007222",
		"key": "story_E0_1_o1",
		"en|ch|tc|kr": "「もちろんです、婆婆」"
	},
	{
		"id": "-1000007223",
		"key": "story_E0_1_o2",
		"en|ch|tc|kr": "「庭いじりの暇はない」"
	},
	{
		"id": "-1000007224",
		"key": "story_E0_2",
		"en|ch|tc|kr": "草取り、水やり——そして桃を盗む霊猿の群れ。"
