	{
		"id": "480110100",
		"key": "battleevent480110100",
		"en|ch|tc|kr": "好きなだけ戦え。砂埃が収まったら、戦利品はわしのものだ。"
	},
	{
		"id": "480110200",
		"key": "battleevent480110200",
		"en|ch|tc|kr": "踏ん張れ、友よ。背中は任せろ！"
	},
	{
		"id": "480110300",
		"key": "battleevent480110300",
		"en|ch|tc|kr": "我が宗門の弟子に手を出す者は、宗門すべてを敵に回すと思え！"
	},
	{
		"id": "480110400",
		"key": "battleevent480110400",
		"en|ch|tc|kr": "城壁の中で喧嘩だと？武器を下ろせ。さもなくば衛兵が貴様らを叩き伏せる！"
	},
	{
		"id": "480110500",
		"key": "battleevent480110500",
		"en|ch|tc|kr": "もう十分ついてきた。今日から我らの道は分かれる――剣先でな。"
	},
	{
		"id": "480110501",
		"key": "battleevent480110501",
		"en|ch|tc|kr": "正道を歩むためにお前についてきたのだ。血で汚すのを見るためではない。今日、それを正す！"
	},
	{
		"id": "480110502",
		"key": "battleevent480110502",
		"en|ch|tc|kr": "説教はやめろ、「正義」の士よ。お前の首と宝はいただく。"
	},
	{
		"id": "480110600",
		"key": "battleevent480110600",
		"en|ch|tc|kr": "妖獣王の宝を手にしたのを見たぞ。渡せば、見逃してやらんこともない。"
	},
	{
		"id": "480110601",
		"key": "battleevent480110601",
		"en|ch|tc|kr": "その収納指輪、重いだろう？荷を軽くしてやろう。"
	},
	{
		"id": "480110602",
		"key": "battleevent480110602",
		"en|ch|tc|kr": "貸しだと思え……二度と戻らない貸しだがな。"
	},
	{
		"id": "480112890",
		"key": "battleevent480112890",
		"en|ch|tc|kr": "城壁に戦鼓が轟き、矢と術が雨のように降り注ぐ。お前は二つの軍の間に挟まれた――どちらを選んでも、もう一方は忘れはしない。"
	},
	{
		"id": "480112891",
		"key": "battleevent480112891",
		"en|ch|tc|kr": "町を守る"
	},
	{
		"id": "480112892",
		"key": "battleevent480112892",
		"en|ch|tc|kr": "攻め手に加わる"
	},
	{
		"id": "480112893",
		"key": "battleevent480112893",
		"en|ch|tc|kr": "今のうちに抜け出す"
	},
	{
		"id": "480112894",
		"key": "battleevent480112894",
		"en|ch|tc|kr": "{0}の軍勢が{1}の門を攻め立てている！守備兵が戦う意志のある修士に呼びかけている。"
	},
	{
		"id": "480112895",
		"key": "battleevent480112895",
		"en|ch|tc|kr": "{0}が包囲されている！城壁から煙が上がり、町の命運は風前の灯だ。"
	},
	{
		"id": "480112898",
		"key": "battleevent480112898",
		"en|ch|tc|kr": "自分には関係ない"
	},
	{
		"id": "480112899",
		"key": "battleevent480112899",
		"en|ch|tc|kr": "呼びかけに応じる"
	},
	{
		"id": "480114101",
		"key": "battleevent480110100_1",
		"en|ch|tc|kr": "一石二鳥だ。互いに弱らせ合ってくれて礼を言う。"
	},
	{
		"id": "480114102",
		"key": "battleevent480110100_2",
		"en|ch|tc|kr": "三日間お前をつけていた。今日、その収納指輪の持ち主が変わる。"
	},
	{
		"id": "480114103",
		"key": "battleevent480110100_3",
		"en|ch|tc|kr": "天が与え、わしが奪う。恨むならわしではなく、己の運を恨め。"
	},
	{
		"id": "480114201",
		"key": "battleevent480110200_1",
		"en|ch|tc|kr": "これが済んだら酒を一壺おごれよ。"
	},
	{
		"id": "480114202",
		"key": "battleevent480110200_2",
		"en|ch|tc|kr": "わしの友に手を出すのか？ならばわしにも答えてもらおう。"
	},
	{
		"id": "480114301",
		"key": "battleevent480110300_1",
		"en|ch|tc|kr": "師弟、下がっていろ。我が宗門の功法を見せてやる。"
	},
	{
		"id": "480114302",
		"key": "battleevent480110300_2",
		"en|ch|tc|kr": "門規は明白だ。仲間は決して見捨てない。"
	},
	{
		"id": "480114401",
		"key": "battleevent480110400_1",
		"en|ch|tc|kr": "城主の命により、騒ぎを起こす者はその場で処罰する！"
	},
	{
		"id": "480114402",
		"key": "battleevent480110400_2",
		"en|ch|tc|kr": "この町には掟がある。痛い目を見て覚えるがいい。"
	},
	{
		"id": "480114501",
		"key": "battleevent480110500_1",
		"en|ch|tc|kr": "お前より高く雇ってくれる者がいた。悪く思うな。"
	},
	{
		"id": "480114511",
		"key": "battleevent480110501_1",
		"en|ch|tc|kr": "お前が傷つけた無辜の者たちが、わしの良心にのしかかる。もうたくさんだ！"
	},
	{
		"id": "480114521",
		"key": "battleevent480110502_1",
		"en|ch|tc|kr": "正義ではここでお前は救われぬ。江湖でものを言うのは力だけだ。"
	},
	{
		"id": "480114610",
		"key": "battleevent480110610",
		"en|ch|tc|kr": "ならば奪いに来い！"
	},
	{
		"id": "480114611",
		"key": "battleevent480110611",
		"en|ch|tc|kr": "金を払って追い払う（霊石{0:#,##0}）"
	},
	{
		"id": "480114612",
		"key": "battleevent480110612",
		"en|ch|tc|kr": "追跡者は袋の重さを確かめ、にやりと笑うと仲間と共に姿を消した。"
	},
	{
		"id": "480114613",
		"key": "battleevent480110613",
		"en|ch|tc|kr": "そんなに霊石は持っていない。追跡者が刃を抜いた。"
	}
